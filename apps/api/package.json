{
  "name": "@tizhice/api",
  "version": "0.0.0",
  "private": true,
  "description": "知体平台后端服务（NestJS）",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\"",
    "test:integration": "vitest run \"**/*.int.spec.ts\"",
    "migration": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/infrastructure/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/typeorm": "11.0.1",
    "@tizhice/shared": "workspace:*",
    "bullmq": "5.77.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.4.2",
    "ioredis": "5.11.0",
    "pg": "8.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@types/node": "24.12.4",
    "rimraf": "6.1.3",
    "source-map-support": "0.5.21",
    "ts-loader": "9.6.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
