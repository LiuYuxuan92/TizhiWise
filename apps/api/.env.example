# 后端 API 应用级环境变量示例（覆盖/补充根级 .env）
# 复制为 apps/api/.env 后填值。
NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api

# 数据库与缓存（任务 1.3 接入）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tizhice
REDIS_URL=redis://localhost:6379

# 应用层加密主密钥（任务 1.4 使用）
APP_ENCRYPTION_KEY=base64-placeholder-do-not-use-in-prod
