# =============================================================================
# 知体平台 — 环境变量约定（根级共享示例）
# 复制为 .env 后填入真实值；.env 不会被提交（见 .gitignore）。
# 各应用可在自身目录维护 apps/<app>/.env 覆盖或补充。
# 切勿将任何密钥、证书、支付凭据提交到仓库（R6.9 / R12.1）。
# =============================================================================

# 运行环境：development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# 后端 API（apps/api）
# -----------------------------------------------------------------------------
API_PORT=3000
API_GLOBAL_PREFIX=api

# PostgreSQL（核心事务库）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tizhice

# Redis（缓存 / 幂等 / 限流 / 会话快照）
REDIS_URL=redis://localhost:6379

# 应用层加密主密钥抽象（实际由 KMS 管理，本地用占位）
# 32 字节密钥的 base64 表示，供 AES-256-GCM 使用（详见任务 1.4）
APP_ENCRYPTION_KEY=base64-placeholder-do-not-use-in-prod

# JWT / 会话签名密钥
JWT_SECRET=change-me-in-local-only

# 微信开放平台（授权登录 / JS-SDK）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信支付 v3（JSAPI）
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=

# LLM Provider（AI 多 Agent 内容生成）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=

# -----------------------------------------------------------------------------
# 前端（apps/h5、apps/admin）—— 仅 VITE_ 前缀变量会注入到浏览器端
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api
VITE_APP_TITLE=知体
